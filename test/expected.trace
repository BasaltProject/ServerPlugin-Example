host command_register("entities bad", "", 55) = 0
host event_on("plugin.enable", 2, 56) = 0
host channel_listen("example:chan", 57) = 0
host packet_listen("serverbound.chat_message", {"priority": "first"}, 58) = 1
host packet_listen("clientbound.*", {"observe": true}, 59) = 2
host packet_listen("serverbound.play.*", {"priority": "late", "observe": true}, 60) = 3
host packet_listen("serverbound.chat_command", null, 61) = 4
host packet_listen("nope", null, 62) = -3
host command_register("pkt <action: word>", "", 63) = 0
callback token=56 ctx=1
host config_i64("payout-amount", 5) = 5
host config_i64("payout-period", 1200) = 1200
host log(1, "ready: 5 coins every 1200 ticks")
world event plugin.enable listeners=1 cancelled=0
# command console coins top
callback token=7 ctx=2
host command_arg_i64(2, "limit") = -1
host store_top("coins", 10, cap=1024) = 0 []
host command_reply(2, "@top-empty", {}) = 0
world reply CONSOLE "<gray>Nobody has any coins yet."
# join Steve
world join Steve handle=1
callback token=3 ctx=3
host event_player(3) = 1
host player_name(1, cap=256) = 5 "Steve"
host data_get_bool(1, "welcomed", 0) = 0
host data_set_bool(1, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(1, "coins", 0) = 0
host data_set_i64(1, "coins", 50) = 0
host player_send(1, "@welcome", {name="Steve", amount="50"}) = 0
world send Steve "<gold>Welcome, <yellow>Steve</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# join Alex
world join Alex handle=2
callback token=3 ctx=4
host event_player(4) = 2
host player_name(2, cap=256) = 4 "Alex"
host data_get_bool(2, "welcomed", 0) = 0
host data_set_bool(2, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(2, "coins", 0) = 0
host data_set_i64(2, "coins", 50) = 0
host player_send(2, "@welcome", {name="Alex", amount="50"}) = 0
world send Alex "<gold>Welcome, <yellow>Alex</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# join Bob
world join Bob handle=3
callback token=3 ctx=5
host event_player(5) = 3
host player_name(3, cap=256) = 3 "Bob"
host data_get_bool(3, "welcomed", 0) = 0
host data_set_bool(3, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(3, "coins", 0) = 0
host data_set_i64(3, "coins", 50) = 0
host player_send(3, "@welcome", {name="Bob", amount="50"}) = 0
world send Bob "<gold>Welcome, <yellow>Bob</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# leave Steve
world event player.leave listeners=0 cancelled=0
world leave Steve
# join Steve
world join Steve handle=4
callback token=3 ctx=6
host event_player(6) = 4
host player_name(4, cap=256) = 5 "Steve"
host data_get_bool(4, "welcomed", 0) = 1
host data_get_i64(4, "coins", 0) = 50
host player_send(4, "@welcome-back", {name="Steve", amount="50"}) = 0
world send Steve "<gray>Welcome back, Steve. Balance: <gold>50</gold> coins."
world event player.join listeners=1 cancelled=0
# command Steve coins
callback token=6 ctx=7
host command_arg_str(7, "target", cap=256) = -1
host command_is_console(7) = 0
host command_source_name(7, cap=256) = 5 "Steve"
host player_by_name("Steve") = 4
host data_get_i64(4, "coins", 0) = 50
host command_reply(7, "@balance-self", {amount="50"}) = 0
world reply Steve "<gray>You have <gold>50</gold> coins."
# command Steve coins Alex
callback token=6 ctx=8
host command_arg_str(8, "target", cap=256) = 4 "Alex"
host player_by_name("Alex") = 2
host player_name(2, cap=256) = 4 "Alex"
host data_get_i64(2, "coins", 0) = 50
host command_reply(8, "@balance-other", {name="Alex", amount="50"}) = 0
world reply Steve "<gray>Alex has <gold>50</gold> coins."
# command Steve coins Nobody
callback token=6 ctx=9
host command_arg_str(9, "target", cap=256) = 6 "Nobody"
host player_by_name("Nobody") = 0
host command_reply(9, "@balance-usage", {}) = 0
world reply Steve "<red>Usage: /coins [player]"
# command console coins
callback token=6 ctx=10
host command_arg_str(10, "target", cap=256) = -1
host command_is_console(10) = 1
host command_reply(10, "@balance-usage", {}) = 0
world reply CONSOLE "<red>Usage: /coins [player]"
# command console coins Steve
callback token=6 ctx=11
host command_arg_str(11, "target", cap=256) = 5 "Steve"
host player_by_name("Steve") = 4
host player_name(4, cap=256) = 5 "Steve"
host data_get_i64(4, "coins", 0) = 50
host command_reply(11, "@balance-other", {name="Steve", amount="50"}) = 0
world reply CONSOLE "<gray>Steve has <gold>50</gold> coins."
# command Steve coins Alex extra
world usage Steve "coins [target: word]"
# command Steve coins top 3
callback token=7 ctx=12
host command_arg_i64(12, "limit") = 0 out=3
host store_top("coins", 3, cap=1024) = 48 ["Alex"=50, "Bob"=50, "Steve"=50]
host command_reply(12, "@top-header", {}) = 0
world reply Steve "<gold><bold>Top coins</bold>"
host command_reply(12, "@top-row", {rank="1", name="Alex", amount="50"}) = 0
world reply Steve "<gray>1. Alex <gold>50</gold>"
host command_reply(12, "@top-row", {rank="2", name="Bob", amount="50"}) = 0
world reply Steve "<gray>2. Bob <gold>50</gold>"
host command_reply(12, "@top-row", {rank="3", name="Steve", amount="50"}) = 0
world reply Steve "<gray>3. Steve <gold>50</gold>"
# command Steve coins top 1
callback token=7 ctx=13
host command_arg_i64(13, "limit") = 0 out=1
host store_top("coins", 1, cap=1024) = 16 ["Alex"=50]
host command_reply(13, "@top-header", {}) = 0
world reply Steve "<gold><bold>Top coins</bold>"
host command_reply(13, "@top-row", {rank="1", name="Alex", amount="50"}) = 0
world reply Steve "<gray>1. Alex <gold>50</gold>"
# command Steve coins top
