host player_by_name("Steve") = 1
host hud_bossbar_create({"title": "<green>Wave 1", "color": "green", "style": "notched_10", "progress": 0.5, "darken_sky": false, "boss_music": false, "fog": false, "visible": true, "key": "example:wave"}) = 1
