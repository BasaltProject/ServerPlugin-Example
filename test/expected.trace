# enable
init
host translate("shop-title", {}, cap=256) = 20 "<dark_gray>Coin Shop"
host menu_create("<dark_gray>Coin Shop", 3) = 1
host config_i64("shop.sparkles-price", 100) = 100
host translate("shop-item-sparkles", {}, cap=256) = 14 "<aqua>Sparkles"
host translate("shop-item-sparkles-lore", {price="100"}, cap=256) = 37 "<gray>100 coins, a burst of particles"
host menu_set(1, 11, "minecraft:blaze_powder", "<aqua>Sparkles", "<gray>100 coins, a burst of particles", 1) = 0
host config_i64("shop.fireworks-price", 150) = 150
host translate("shop-item-fireworks", {}, cap=256) = 23 "<light_purple>Fireworks"
host translate("shop-item-fireworks-lore", {price="150"}, cap=256) = 42 "<gray>150 coins, one firework at your feet"
host menu_set(1, 15, "minecraft:firework_rocket", "<light_purple>Fireworks", "<gray>150 coins, one firework at your feet", 2) = 0
host event_on("player.join", 2, 3) = 0
host config_i64("payout-period", 1200) = 1200
host task_every(1200, 1200, 4) = 1
host placeholder_register("coins", 5) = 0
host command_register("coins [target: word]", "", 6) = 0
host command_register("coins top [limit: int 1..25]", "", 7) = 0
host command_register("shop", "example.shop", 8) = 0
host event_on_ex("player.chat", 2, 0, none, 9) = 0
host event_on_ex("player.chat", 4, 3, none, 10) = 0
host event_on_ex("player.join", 1, 0, {"world": "world"}, 11) = 0
host event_on_ex("example:ping", 2, 0, none, 12) = 0
host event_on_ex("no.such.event", 2, 0, none, 13) = -3
host permission_provide(10, 3, 14) = 1
host service_register("example.echo", 15) = 1
host command_register("srv hello", "", 16) = 0
host command_register("srv perms", "", 17) = 0
