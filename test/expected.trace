host command_register("items take <id: word> [count: int 1..64]", "", 37) = 0
host command_register("items count <id: word>", "", 38) = 0
host command_register("items slot <slot: int 0..40>", "", 39) = 0
host command_register("items hand", "", 40) = 0
host command_register("items chest", "", 41) = 0
host command_register("items ender", "", 42) = 0
host command_register("items cooldown <id: word> <ticks: int 0..1000>", "", 43) = 0
host command_register("items registry <kind: word> <key: word>", "", 44) = 0
host command_register("items level <level: int 1..10>", "", 45) = 0
host command_register("items recipes", "", 46) = 0
host command_register("items book", "", 47) = 0
host command_register("items craft", "", 48) = 0
host command_register("items menu", "", 49) = 0
host command_register("items closemenu", "", 50) = 0
host command_register("items window", "", 51) = 0
host command_register("items merchant", "", 52) = 0
host command_register("items loot", "", 53) = 0
