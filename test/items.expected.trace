host command_reply(26, "@items-line", {text="menu 1"}) = 0
world reply Steve "<gray>menu 1"
host container_menu_set(1, 2, {"id": "minecraft:diamond", "count": 1, "name": "<aqua>Click me"}, 64) = 0
host command_reply(26, "@items-line", {text="slot 2 0"}) = 0
world reply Steve "<gray>slot 2 0"
host container_menu_set(1, 4, {"id": "minecraft:barrier", "count": 1, "name": "<red>Refuse"}, 65) = 0
host command_reply(26, "@items-line", {text="slot 4 0"}) = 0
world reply Steve "<gray>slot 4 0"
host container_menu_set(1, 99, {"id": "minecraft:diamond", "count": 1}, 0) = -3
host command_reply(26, "@items-line", {text="slot 99 -3"}) = 0
world reply Steve "<gray>slot 99 -3"
world window opened Steve chest "<gold>Items menu" slots=45
host container_menu_open(1, 1) = 0
host command_reply(26, "@items-line", {text="open 0"}) = 0
world reply Steve "<gray>open 0"
# items-click 1 2 Steve
callback token=64 ctx=27
host container_menu_click_info(27, cap=256) = 40 {"player": 1, "slot": 2, "button": 0, "mode": "pickup"}
host log(1, "clicked slot 2")
host container_menu_click_result(27, {"id": "minecraft:emerald", "count": 1}) = 0
host container_menu_click_cancel(27, 1) = 0
host log(1, "cancel 0")
world menu 1 slot 2 = {"id": "minecraft:emerald", "count": 1}
# items-click 1 4 Steve
callback token=65 ctx=28
host container_menu_click_cancel(28, 0) = -4
host log(1, "uncancel -4")
host container_menu_click_result(28, null) = 0
world menu 1 slot 4 = null
# items-click 1 0 Steve
world click-ignored items menu=1 slot=0
# command Steve items closemenu
callback token=50 ctx=29
host command_source_name(29, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
world window closed Steve
host container_menu_close(1, 1) = 0
host command_reply(29, "@items-line", {text="close 0"}) = 0
world reply Steve "<gray>close 0"
host command_source_name(29, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
host container_menu_close(1, 1) = -1
host command_reply(29, "@items-line", {text="close again -1"}) = 0
world reply Steve "<gray>close again -1"
# leave Steve
world event player.leave listeners=0 cancelled=0
world leave Steve
# command console items give bread 1
callback token=36 ctx=30
host command_arg_str(30, "id", cap=256) = 5 "bread"
host command_source_name(30, cap=256) = 7 "CONSOLE"
host player_by_name("CONSOLE") = 0
host inventory_of_player(0) = -3
host command_arg_i64(30, "count") = 0 out=1
host inventory_add(-3, {"id": "minecraft:bread", "count": 1, "name": "<gold>Gift"}) = -3
host command_reply(30, "@items-line", {text="left over -3"}) = 0
world reply CONSOLE "<gray>left over -3"
