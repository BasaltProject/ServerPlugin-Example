# command Steve hud holograms
callback token=30 ctx=6
host command_source_name(6, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
host player_name(1, cap=256) = 5 "Steve"
host hud_hologram_create("world", "<yellow>Hello", 0.5, 64, 0.5) = 1
