world unknown-command "unknown"
# placeholder coins Steve
callback token=5 ctx=15
host placeholder_player(15) = 4
host data_get_i64(4, "coins", 0) = 50
host placeholder_result(15, "50") = 0
world placeholder coins = "50"
# placeholder coins none
callback token=5 ctx=16
host placeholder_player(16) = 0
host placeholder_result(16, "0") = 0
world placeholder coins = "0"
# placeholder missing none
world placeholder-unknown missing
# command console shop
callback token=8 ctx=17
host command_is_console(17) = 1
host command_reply(17, "@shop-players-only", {}) = 0
world reply CONSOLE "<red>The shop needs a player, not the console."
# command Steve shop
callback token=8 ctx=18
host command_is_console(18) = 0
host command_source_name(18, cap=256) = 5 "Steve"
host player_by_name("Steve") = 4
host menu_open(1, 4) = 0
world menu 1 opens for Steve title="<dark_gray>Coin Shop" rows=3
world menu-slot 11 item="minecraft:blaze_powder" name="<aqua>Sparkles" lore="<gray>100 coins, a burst of particles"
world menu-slot 15 item="minecraft:firework_rocket" name="<light_purple>Fireworks" lore="<gray>150 coins, one firework at your feet"
