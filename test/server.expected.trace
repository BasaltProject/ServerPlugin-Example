# command Steve srv perms
callback token=17 ctx=4
host command_source_name(4, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
host permission_has(1, "example.vip") = 0
host command_reply(4, "@server-line", {text="has example.vip 0"}) = 0
world reply Steve "<gray>has example.vip 0"
host permission_check("console", "example.vip") = 1
host command_reply(4, "@server-line", {text="console has example.vip 1"}) = 0
world reply Steve "<gray>console has example.vip 1"
host permission_set(1, "example.vip", 1) = 0
world permission Steve "example.vip" granted
world command-tree Steve
host command_reply(4, "@server-line", {text="grant 0"}) = 0
world reply Steve "<gray>grant 0"
host permission_has(1, "example.vip") = 1
host command_reply(4, "@server-line", {text="has example.vip 1"}) = 0
world reply Steve "<gray>has example.vip 1"
host permission_set(1, "example.vip", -1) = 0
world permission Steve "example.vip" dropped
world command-tree Steve
host command_reply(4, "@server-line", {text="drop 0"}) = 0
world reply Steve "<gray>drop 0"
host permission_has(1, "example.vip") = 0
host command_reply(4, "@server-line", {text="has example.vip 0"}) = 0
world reply Steve "<gray>has example.vip 0"
host permission_meta("Steve", "prefix", cap=128) = 8 "[Member]"
