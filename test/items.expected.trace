world event plugin.enable listeners=1 cancelled=0
# join Steve
world join Steve handle=1
callback token=3 ctx=2
host event_player(2) = 1
host player_name(1, cap=256) = 5 "Steve"
host data_get_bool(1, "welcomed", 0) = 0
host data_set_bool(1, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(1, "coins", 0) = 0
host data_set_i64(1, "coins", 50) = 0
host player_send(1, "@welcome", {name="Steve", amount="50"}) = 0
world send Steve "<gold>Welcome, <yellow>Steve</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# command Steve items give minecraft:bread 5
callback token=36 ctx=3
host command_arg_str(3, "id", cap=256) = 15 "minecraft:bread"
host command_source_name(3, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
host inventory_of_player(1) = 1
host command_arg_i64(3, "count") = 0 out=5
host inventory_add(1, {"id": "minecraft:bread", "count": 5, "name": "<gold>Gift"}) = 0
world inventory player:Steve added {"id": "minecraft:bread", "count": 5, "name": "<gold>Gift"} leftover=0
host command_reply(3, "@items-line", {text="left over 0"}) = 0
world reply Steve "<gray>left over 0"
host inventory_release(1) = 0
