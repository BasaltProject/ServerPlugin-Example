callback token=56 ctx=1
host config_i64("payout-amount", 5) = 5
host config_i64("payout-period", 1200) = 1200
host log(1, "ready: 5 coins every 1200 ticks")
world event plugin.enable listeners=1 cancelled=0
# join Steve
world join Steve handle=1
callback token=3 ctx=2
host event_player(2) = 1
host player_name(1, cap=256) = 5 "Steve"
host data_get_bool(1, "welcomed", 0) = 0
host data_set_bool(1, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(1, "coins", 0) = 0
host data_set_i64(1, "coins", 50) = 0
host player_send(1, "@welcome", {name="Steve", amount="50"}) = 0
world send Steve "<gold>Welcome, <yellow>Steve</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# join Alex
world join Alex handle=2
callback token=3 ctx=3
host event_player(3) = 2
host player_name(2, cap=256) = 4 "Alex"
host data_get_bool(2, "welcomed", 0) = 0
host data_set_bool(2, "welcomed", 1) = 0
host config_i64("welcome-bonus", 50) = 50
host data_get_i64(2, "coins", 0) = 0
host data_set_i64(2, "coins", 50) = 0
host player_send(2, "@welcome", {name="Alex", amount="50"}) = 0
world send Alex "<gold>Welcome, <yellow>Alex</yellow>! Here is <green>50</green> coins to get started."
world event player.join listeners=1 cancelled=0
# command Steve hud board
callback token=28 ctx=4
host command_source_name(4, cap=256) = 5 "Steve"
host player_by_name("Steve") = 1
host hud_scoreboard_main() = 1
host hud_scoreboard_create() = 2
host hud_objective_add(2, "kills", {"criterion": "dummy", "title": "<gold>Kills", "hearts": false}) = 0
host hud_objective_add(2, "broken", {"criterion": "no_such_criterion"}) = -3
host hud_scoreboard_list(2, "objectives", cap=256) = 9 ["kills"]
host hud_display_set(2, "sidebar", "kills") = 0
host hud_display_get(2, "sidebar", cap=256) = 5 "kills"
host hud_display_set(2, "sidebar", "missing") = -1
host hud_display_set(2, "nowhere", "kills") = -3
host hud_score_set(2, "Steve", "kills", 7) = 0
host hud_score_set(2, "Alex", "kills", 3) = 0
host hud_score_get(2, "Steve", "kills") = 0 out=7
host hud_scoreboard_list(2, "entries", cap=256) = 15 ["Alex", "Steve"]
host hud_score_reset(2, "Steve", "kills") = 0
host hud_score_get(2, "Steve", "kills") = -1
host hud_team_add(2, "red") = 0
host hud_team_add(2, "red") = -3
host hud_team_set(2, "red", {"display_name": "<red>Red", "prefix": "[R] ", "suffix": "!", "color": "red", "friendly_fire": false, "see_invisible": true, "name_tags": "hideForOtherTeams", "death_messages": "never", "collision": "pushOtherTeams"}) = 0
host hud_team_set(2, "blue", {"color": "blue"}) = -1
host hud_team_join(2, "red", "Steve") = 0
host hud_team_join(2, "gone", "Steve") = -1
host hud_team_of(2, "Steve", cap=256) = 3 "red"
host hud_scoreboard_list(2, "teams", cap=256) = 7 ["red"]
host hud_scoreboard_list(2, "bogus", cap=256) = -3
host hud_team_leave(2, "red", "Steve") = 0
host hud_team_leave(2, "red", "Steve") = -1
host hud_team_of(2, "Steve", cap=256) = -1
host hud_team_remove(2, "red") = 0
host hud_team_remove(2, "red") = -1
host hud_scoreboard_show(1, 2) = 0
host hud_scoreboard_shown(1) = 2
host hud_scoreboard_show(1, 1) = 0
host hud_scoreboard_shown(1) = 1
host hud_objective_remove(2, "kills") = 0
host hud_objective_remove(2, "kills") = -1
host hud_scoreboard_release(2) = 0
host hud_scoreboard_release(2) = -2
host hud_scoreboard_release(1) = -3
host command_reply(4, "board done", {}) = 0
world reply Steve "board done"
# command Steve hud bars
