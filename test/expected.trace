host command_arg_i64(14, "limit") = -1
host store_top("coins", 10, cap=1024) = 48 ["Alex"=50, "Bob"=50, "Steve"=50]
host command_reply(14, "@top-header", {}) = 0
world reply Steve "<gold><bold>Top coins</bold>"
