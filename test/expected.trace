host command_reply(14, "@top-row", {rank="2", name="Bob", amount="50"}) = 0
world reply Steve "<gray>2. Bob <gold>50</gold>"
host command_reply(14, "@top-row", {rank="3", name="Steve", amount="50"}) = 0
world reply Steve "<gray>3. Steve <gold>50</gold>"
