callback token=65 ctx=12
host hud_surface_answer(12, {"title": "<gold>Example", "lines": ["<white>Hello %player%", "<gray>second line"]}) = 0
world surface sidebar Steve {"title": "<gold>Example", "lines": ["<white>Hello %player%", "<gray>second line"]}
